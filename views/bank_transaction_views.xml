<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_transaction_list" model="ir.ui.view">
        <field name="name">bank.transaction.list</field>
        <field name="model">bank.transaction</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'review'" decoration-muted="state == 'error'">
                <field name="transaction_date"/>
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="direction"/>
                <field name="amount" sum="Total Amount"/>
                <field name="currency_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
                <field name="journal_id" optional="hide"/>
                <field name="move_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bank_transaction_form" model="ir.ui.view">
        <field name="name">bank.transaction.form</field>
        <field name="model">bank.transaction</field>
        <field name="arch" type="xml">
            <form string="Bank Transaction">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="pending,processed,review,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="partner_id"/>
                            <field name="direction"/>
                            <field name="transaction_date"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="journal_id"/>
                            <field name="processed_at" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="review_reason" readonly="1" invisible="not review_reason"/>
                        <field name="error_message" readonly="1" invisible="not error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bank_transaction_search" model="ir.ui.view">
        <field name="name">bank.transaction.search</field>
        <field name="model">bank.transaction</field>
        <field name="arch" type="xml">
            <search string="Bank Transactions">
                <field name="reference"/>
                <field name="partner_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="review" string="Needs Review" domain="[('state', '=', 'review')]"/>
                <filter name="errors" string="Errors" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bank_transactions" model="ir.actions.act_window">
        <field name="name">Bank Transactions</field>
        <field name="res_model">bank.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_bank_transaction_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_bank_transaction_form')})]"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <menuitem id="menu_bank_transaction_root" name="Bank Monitoring" sequence="55" groups="group_bank_transaction_user"/>
    <menuitem id="menu_bank_transactions" name="Transactions" parent="menu_bank_transaction_root" action="action_bank_transactions" sequence="10" groups="group_bank_transaction_user"/>
</odoo>
